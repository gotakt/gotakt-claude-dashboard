<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.gotakt.claude-dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__HOME__/claude-pages/dashboard/dash.py</string>
    <string>--serve</string>
    <string>8787</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/claude-pages/dashboard</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/claude-pages/dashboard/logs/aus.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/claude-pages/dashboard/logs/fehler.log</string>
</dict>
</plist>
